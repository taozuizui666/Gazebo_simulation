<sdf version="1.6">
  <model name="wall">
    <static>true</static>

    <link name="wall_link">
      <visual name="visual">
        <geometry>
          <box>
            <size>0.5 0.1 0.5</size>
          </box>
        </geometry>
        <origin xyz="0.0 0.0 0.25" rpy="0.0 0.0 0.0"/>
      </visual>

      <collision name="collision">
        <geometry>
          <box>
            <size>0.5 0.1 0.5</size>
          </box>
        </geometry>
        <origin xyz="0.0 0.0 0.25" rpy="0.0 0.0 0.0"/>
      </collision>
    </link>

  </model>
</sdf>