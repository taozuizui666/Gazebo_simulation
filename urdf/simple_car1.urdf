<?xml version="1.0"?>
<robot name="simple_car">
    <!-- Base link -->
    <link name="base_link">
      <visual>
        <geometry>
          <box size="0.12 0.08 0.10"/>
        </geometry>
        <origin xyz="0.0 0.0 0.0625" rpy="0.0 0.0 0.0"/>
      </visual>
      <collision>
        <geometry>
          <box size="0.13 0.09 0.12"/>
          <!-- <cylinder radius="0.1" length="0.10"/> -->
        </geometry>
        <origin xyz="0.0 0.0 0.0625" rpy="0.0 0.0 0.0"/>
      </collision>
      <inertial>
        <mass value="1.0"/>
        <origin xyz="0.0 0.0 0.0625" rpy="0 0 0"/>
        <inertia 
          ixx="0.01" ixy="0.0" ixz="0.0"
          iyy="0.01" iyz="0.0"
          izz="0.01"/>
      </inertial>
    </link>
    <!-- Left wheel link -->
    <link name="left_wheel_link">
      <visual>
        <geometry>
          <cylinder radius="0.0325" length="0.006"/>
        </geometry>
      </visual>
      <collision>
        <geometry>
          <cylinder radius="0.0325" length="0.006"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.5"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia 
          ixx="0.00026" ixy="0.0" ixz="0.0"
          iyy="0.00026" iyz="0.0"
          izz="0.00026"/>
      </inertial>      
    </link>
    <!-- Right wheel link -->
    <link name="right_wheel_link">
      <visual>
        <geometry>
          <cylinder radius="0.0325" length="0.006"/>
        </geometry>
      </visual>
      <collision>
        <geometry>
          <cylinder radius="0.0325" length="0.006"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.5"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia 
          ixx="0.00026" ixy="0.0" ixz="0.0"
          iyy="0.00026" iyz="0.0"
          izz="0.00026"/>
      </inertial>      
    </link>

    <gazebo reference="left_wheel_link">
      <!-- 摩擦系数：提供抓地力 -->
      <mu1>30.0</mu1>
      <mu2>30.0</mu2>
      <!-- 接触刚度：让车轮坚硬（不易变形） -->
      <kp>500000</kp>
      <!-- 接触阻尼：吸收震动，防止弹跳（kd/kp ≈ 0.02） -->
      <kd>10000</kd>
    </gazebo>

    <gazebo reference="right_wheel_link">
      <!-- 摩擦系数：提供抓地力 -->
      <mu1>30.0</mu1>
      <mu2>30.0</mu2>
      <!-- 接触刚度：让车轮坚硬（不易变形） -->
      <kp>500000</kp>
      <!-- 接触阻尼：吸收震动，防止弹跳 -->
      <kd>10000</kd>
    </gazebo>  

    <!-- Front Support Link -->
    <link name="front_support">
      <visual>
        <geometry>
          <sphere radius="0.01"/>
        </geometry>
        <origin xyz="0.0 0.0 0.01" rpy="0.0 0.0 0.0"/>
      </visual>
      <collision>
        <geometry>
          <sphere radius="0.01"/>
        </geometry>
        <origin xyz="0.0 0.0 0.01" rpy="0.0 0.0 0.0"/>
      </collision>
      <inertial>
        <mass value="1.0"/>
        <origin xyz="0.0 0.0 0.01" rpy="0 0 0"/>
        <inertia 
          ixx="0.001" ixy="0.0" ixz="0.0"
          iyy="0.001" iyz="0.0"
          izz="0.001"/>
      </inertial>
    </link>
    <!-- Back Support Link -->
    <link name="back_support">
      <visual>
        <geometry>
          <sphere radius="0.01"/>
        </geometry>
        <origin xyz="0.0 0.0 0.01" rpy="0.0 0.0 0.0"/>
      </visual>
      <collision>
        <geometry>
          <sphere radius="0.01"/>
        </geometry>
        <origin xyz="0.0 0.0 0.01" rpy="0.0 0.0 0.0"/>
      </collision>
      <inertial>
        <mass value="1.0"/>
        <origin xyz="0.0 0.0 0.01" rpy="0 0 0"/>
        <inertia 
          ixx="0.001" ixy="0.0" ixz="0.0"
          iyy="0.001" iyz="0.0"
          izz="0.001"/>
      </inertial>
    </link>    

    <gazebo reference="front_support">
      <material>Gazebo/Black</material>
      <mu1>0.0001</mu1>
      <mu2>0.0001</mu2>
      <kp>500000</kp>
      <kd>10000</kd>
    </gazebo>
    <gazebo reference="back_support">
      <material>Gazebo/Black</material>
      <mu1>0.0001</mu1>
      <mu2>0.0001</mu2>
      <kp>500000</kp>
      <kd>10000</kd>
    </gazebo>

    <!-- LIDAR Link -->
    <link name="lidar_link">
      <visual>
        <geometry>
          <cylinder radius="0.035" length="0.02"/>
        </geometry>
      </visual>
      <collision>
        <geometry>
          <cylinder radius="0.035" length="0.02"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.2"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia 
          ixx="0.0001" ixy="0.0" ixz="0.0"
          iyy="0.0001" iyz="0.0"
          izz="0.0001"/>
      </inertial>
    </link>

<!-- Joints -->
    <joint name="left_wheel" type="continuous">
      <parent link="base_link"/>
      <child link="left_wheel_link"/>
      <origin xyz="0.0 0.055 0.0325" rpy="1.5708 0 0"/>
      <axis xyz="0 0 1"/>
    </joint>
    <joint name="right_wheel" type="continuous">
      <parent link="base_link"/>
      <child link="right_wheel_link"/>
      <origin xyz="0.0 -0.055 0.0325" rpy="1.5708 0 0"/>
      <axis xyz="0 0 1"/>
    </joint>
    <joint name="front_support" type="fixed">
      <parent link="base_link"/>
      <child link="front_support"/>
      <origin xyz="0.04 0.0 0.0" rpy="0 0 0"/>
    </joint>
    <joint name="back_support" type="fixed">
      <parent link="base_link"/>
      <child link="back_support"/>
      <origin xyz="-0.04 0.0 0.0" rpy="0 0 0"/>
    </joint>
    <joint name="lidar" type="fixed">
      <parent link="base_link"/>
      <child link="lidar_link"/>
      <origin xyz="0.017 0.0 0.13" rpy="0 0 0"/>
    </joint>

<!-- Diff Drive Plugin -->
  <gazebo>
    <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">

      <ros>
        <namespace>/</namespace>
        <remapping>cmd_vel:=cmd_vel</remapping>
      </ros>

      <left_joint>left_wheel</left_joint>
      <right_joint>right_wheel</right_joint>

      <wheel_separation>0.11</wheel_separation>
      <wheel_radius>0.0325</wheel_radius>
      <wheel_diameter>0.065</wheel_diameter>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>

    </plugin>
  </gazebo>   

  <!-- LIDAR Sensor -->
  <gazebo reference="lidar_link">
    <material>Gazebo/Red</material>
    <sensor type="ray" name="lidar_sensor">
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>300</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.09</min>
          <max>10.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
      <noise>
        <type>gaussian</type>
        <mean>0.0</mean>
        <stddev>0.01</stddev>
      </noise>

      <plugin name="gazebo_ros_laser" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <namespace>/</namespace>
          <remapping>~/out:=scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frameName>lidar_link</frameName>
      </plugin>
    </sensor>
  </gazebo>


  <!--END  -->
</robot>
